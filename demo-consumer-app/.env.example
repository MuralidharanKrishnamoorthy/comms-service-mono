# Copy to .env and fill in. .env is git-ignored — never commit a real key.

# ── 1. Where Notifyr is ───────────────────────────────────────────────────────
COMMS_BASE_URL=http://localhost:3000

# ── 2. Your API key ───────────────────────────────────────────────────────────
# Dashboard → your project → API Keys → Create. Shown once, at creation.
COMMS_API_KEY=csvc_replace_me

# ── 3. Your email ─────────────────────────────────────────────────────────────
# Prefills the checkout. While Resend is in sandbox it only delivers to the
# address that owns the Resend account, so put yours here.
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_NAME=

# ── 4. Your local database ────────────────────────────────────────────────────
# The storefront's own orders and payments. Separate from Notifyr's database.
STORE_MONGODB_URI=mongodb://localhost:27017
STORE_DB_NAME=acme_storefront


# ── Optional ──────────────────────────────────────────────────────────────────

# Use your own template instead of the default INVOICE_PAID. Create it in the
# dashboard first. Whatever variables it declares, the app already sends these:
#
#   customer_name  customer_email  user_name
#   order_no  order_id  invoice_no  invoice_number  items_summary  item_count
#   subtotal  tax  amount_paid  total  amount  currency
#   payment_ref  payment_id  paid_on  paid_date
#   store_name  company_name  brand
#
# Anything your template doesn't use is ignored. If it needs something not on
# this list, the send returns 422 naming it — add it to orderVariables() in
# src/store.ts.
# NOTIFYR_TEMPLATE_KEY=INVOICE_PAID

# Port for this storefront. Default 4321.
# PORT=4321

# Shop name: browser tab, header, and the store_name / company_name / brand
# template variables. Default "Acme Storefront".
# STORE_NAME=Acme Storefront
