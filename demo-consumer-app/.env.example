# Copy to .env and fill in. .env is git-ignored — never commit a real key.

PORT=4321

# Where Notifyr's API is listening.
COMMS_BASE_URL=http://localhost:3000

# Dashboard → your project → API Keys → Create key.
# The full value is shown exactly once, at creation. Paste it here.
COMMS_API_KEY=csvc_replace_me

# Cosmetic: the store name this app puts in template variables.
STORE_NAME=Acme Storefront

# Used to build order_url in outgoing notifications.
PUBLIC_URL=http://localhost:4321

# The storefront keeps its own orders and payments here — its own database,
# separate from Notifyr's.
STORE_MONGODB_URI=mongodb://localhost:27017
STORE_DB_NAME=acme_storefront
