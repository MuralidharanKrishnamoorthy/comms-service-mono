# Backend configuration. Copy to backend/.env and fill in.
#
#   cp backend/.env.example backend/.env
#
# The server refuses to start if any REQUIRED value is missing. That is
# deliberate: each one protects something, and a silent default would leave the
# service running with a secret that is published in this repository.
#
# Generate any secret below with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


# --- Database (required) -----------------------------------------------------

MONGODB_URI=mongodb://localhost:27017
DB_NAME=comms_service


# --- Secrets (required) ------------------------------------------------------

# Signs dashboard session cookies. Anyone who knows this value can mint a
# session for any existing user, and such a session cannot be revoked before it
# expires (8h). Use a different value per environment.
DASH_JWT_SECRET=

# Encrypts the stored copy of each API key, which is what the dashboard's
# reveal/copy button decrypts. Changing this makes every existing stored key
# unreadable, so re-encrypt before rotating it.
API_KEY_ENCRYPTION_KEY=


# --- First administrator (required on a fresh database) ----------------------

# Used once, only when the users collection is empty, to create the first admin.
# The account is created with must_change_password set, so this value is
# replaced at first login and can be removed afterwards.
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=


# --- Email delivery (required to send email) ---------------------------------

# Email is the only live channel; SMS and push use stub providers.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev


# --- Optional ----------------------------------------------------------------

# Set to "true" only when the API sits behind a reverse proxy or load balancer
# that sets X-Forwarded-For. It makes login rate limiting read the client IP
# from that header. Leave unset when the API is reachable directly: the header
# can be forged, and trusting it would let an attacker mint a fresh rate-limit
# quota per request.
# TRUST_PROXY=true

# Set to "production" to mark session cookies Secure (HTTPS only).
# NODE_ENV=production
